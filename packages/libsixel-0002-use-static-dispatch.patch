From 79852aabad909dc27f3931747aa5c085a06b1463 Mon Sep 17 00:00:00 2001
From: _ <>
Date: Sun, 10 May 2026 00:00:00 +0000
Subject: [PATCH] use static dispatch

---
 src/cpu.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/cpu.c b/src/cpu.c
index 12ea5b8..aaa1e75 100644
--- a/src/cpu.c
+++ b/src/cpu.c
@@ -221,6 +221,7 @@ sixel_cpu_min(enum sixel_simd_level lhs, enum sixel_simd_level rhs)
 int
 sixel_cpu_simd_level(void)
 {
+    /*
     int cached;
     int expected;
     int resolved;
@@ -253,6 +254,16 @@ sixel_cpu_simd_level(void)
 
     SIXEL_CPU_CACHE_STORE(resolved);
     return resolved;
+    */
+    #if defined(__x86_64__)
+        #if defined(__AVX__)
+            return SIXEL_SIMD_LEVEL_AVX;
+        #else
+            return SIXEL_SIMD_LEVEL_SSE2;
+        #endif
+    #elif defined(__aarch64__)
+        return SIXEL_SIMD_LEVEL_NEON;
+    #endif
 }
 
 
