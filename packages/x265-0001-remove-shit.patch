index 3b91689..49fec82 100644
--- a/source/common/cpu.cpp
+++ b/source/common/cpu.cpp
@@ -152,10 +152,17 @@ bool detect512()
 
 uint32_t cpu_detect(bool benableavx512)
 {
+
+    uint32_t cpu = X265_CPU_MMX|X265_CPU_MMX2|X265_CPU_SSE|X265_CPU_SSE2|X265_CPU_SSE3|X265_CPU_SSSE3|X265_CPU_SSE2_IS_FAST|X265_CPU_SSE4|X265_CPU_SSE42|X265_CPU_AVX|X265_CPU_AVX2|X265_CPU_FMA3|X265_CPU_BMI1|X265_CPU_LZCNT|X265_CPU_BMI2;
+    #if defined(__AVX512F__) && defined(__AVX512VL__) && defined(__AVX512DQ__) && defined(__AVX512BW__) && defined(__AVX512CD__)
+        cpu |= X265_CPU_AVX512;
+    #endif
+    return cpu;
+
     (void)benableavx512;
     uint32_t flags = 0;
 
-#ifdef ENABLE_ASSEMBLY
+#ifdef ENABLE_ASSEMBLY && 0
     flags = x86_cpu_detect(benableavx512);
     if (flags & X265_CPU_AVX512)
         enable512 = true;
@@ -188,7 +195,22 @@ uint32_t cpu_detect(bool benableavx512)
     uint32_t flags = 0;
 
 #ifdef ENABLE_ASSEMBLY
-    flags = aarch64_cpu_detect();
+    flags = X265_CPU_NEON;
+    #if defined(__ARM_FEATURE_DOTPROD)
+        flags |= X265_CPU_NEON_DOTPROD;
+    #endif
+    #if defined(__ARM_FEATURE_MATMUL_INT8)
+        flags |= X265_CPU_NEON_I8MM;
+    #endif
+    #if defined(__ARM_FEATURE_SVE)
+        flags |= X265_CPU_SVE;
+    #endif
+    #if defined(__ARM_FEATURE_SVE2)
+        flags |= X265_CPU_SVE2;
+    #endif
+    #if defined(__ARM_FEATURE_SVE2_BITPERM)
+        flags |= X265_CPU_SVE2_BITPERM;
+    #endif
 #endif
 
     return flags;
