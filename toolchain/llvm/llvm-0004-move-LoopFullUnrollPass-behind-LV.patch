From 075c8480685d38786333ffcae72bdaf4b1a48dea Mon Sep 17 00:00:00 2001
From: _ <>
Date: Sun, 30 Aug 2026 00:00:00 +0000
Subject: [PATCH] move LoopFullUnrollPass behind LV

---
 llvm/lib/Passes/PassBuilderPipelines.cpp | 27 +++++++++++++++---------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/llvm/lib/Passes/PassBuilderPipelines.cpp b/llvm/lib/Passes/PassBuilderPipelines.cpp
index 7a7e26276d..89ab8d5f37 100644
--- a/llvm/lib/Passes/PassBuilderPipelines.cpp
+++ b/llvm/lib/Passes/PassBuilderPipelines.cpp
@@ -446,11 +446,11 @@ PassBuilder::buildO1FunctionSimplificationPipeline(OptimizationLevel Level,
   // inaccurate. The normal unroller doesn't pay attention to forced full unroll
   // attributes so we need to make sure and allow the full unroll pass to pay
   // attention to it.
-  if (!isThinLTOPreLink(Phase) || !PGOOpt ||
-      PGOOpt->Action != PGOOptions::SampleUse)
-    LPM2.addPass(LoopFullUnrollPass(static_cast<int>(Level),
-                                    /* OnlyWhenForced= */ !PTO.LoopUnrolling,
-                                    *PTO.ForgetAllSCEVInLoopUnroll));
+  //if (!isThinLTOPreLink(Phase) || !PGOOpt ||
+  //    PGOOpt->Action != PGOOptions::SampleUse)
+  //  LPM2.addPass(LoopFullUnrollPass(static_cast<int>(Level),
+  //                                  /* OnlyWhenForced= */ !PTO.LoopUnrolling,
+  //                                  *PTO.ForgetAllSCEVInLoopUnroll));
 
   invokeLoopOptimizerEndEPCallbacks(LPM2, Level);
 
@@ -628,11 +628,11 @@ PassBuilder::buildFunctionSimplificationPipeline(OptimizationLevel Level,
   // inaccurate. The normal unroller doesn't pay attention to forced full unroll
   // attributes so we need to make sure and allow the full unroll pass to pay
   // attention to it.
-  if (!isThinLTOPreLink(Phase) || !PGOOpt ||
-      PGOOpt->Action != PGOOptions::SampleUse)
-    LPM2.addPass(LoopFullUnrollPass(static_cast<int>(Level),
-                                    /* OnlyWhenForced= */ !PTO.LoopUnrolling,
-                                    *PTO.ForgetAllSCEVInLoopUnroll));
+  //if (!isThinLTOPreLink(Phase) || !PGOOpt ||
+  //    PGOOpt->Action != PGOOptions::SampleUse)
+  //  LPM2.addPass(LoopFullUnrollPass(static_cast<int>(Level),
+  //                                  /* OnlyWhenForced= */ !PTO.LoopUnrolling,
+  //                                  *PTO.ForgetAllSCEVInLoopUnroll));
 
   invokeLoopOptimizerEndEPCallbacks(LPM2, Level);
 
@@ -1286,6 +1286,13 @@ void PassBuilder::addVectorPasses(OptimizationLevel Level,
                                      /*AggregateToVector=*/true)));
   }
 
+  LoopPassManager LPM;
+  LPM.addPass(LoopFullUnrollPass(static_cast<int>(Level),
+                                 /* OnlyWhenForced= */ !PTO.LoopUnrolling,
+                                 *PTO.ForgetAllSCEVInLoopUnroll));
+  FPM.addPass(createFunctionToLoopPassAdaptor(std::move(LPM),
+                                              /*UseMemorySSA=*/false));
+
   if (!isFullLTOPostLink(LTOPhase)) {
     // Eliminate loads by forwarding stores from the previous iteration to loads
     // of the current iteration.
-- 
