@@ -23261,6 +23295,170 @@ SDValue X86TargetLowering::lowerFaddFsub(SDValue Op, SelectionDAG &DAG) const {
   return lowerAddSubToHorizontalOp(Op, SDLoc(Op), DAG, Subtarget);
 }
 
+// Convert ISD::IS_FPCLASS to X86ISD::VFPCLASS or X86ISD::VFPCLASSS.
+static SDValue LowerIS_FPCLASS(SDValue Op, const X86Subtarget &Subtarget,
+                               SelectionDAG &DAG) {
+  SDLoc DL(Op);
+  MVT ResultVT = Op.getSimpleValueType();
+  SDValue Src = Op.getOperand(0);
+  MVT SrcVT = Src.getSimpleValueType();
+  unsigned Check = Op.getConstantOperandVal(1);
+
+  // Handle scalar types using VFPCLASSS instruction.
+  if (!SrcVT.isVector()) {
+    // Check for fcFinite/fcNormal - can be handled by inverting.
+    bool Invert = false;
+    if (Check == fcFinite) {
+      Check = fcNan | fcInf;
+      Invert = true;
+    } else if (Check == fcNormal) {
+      Check = fcNan | fcInf | fcSubnormal | fcZero;
+      Invert = true;
+    }
+
+    // Convert LLVM FPClassTest flags to VFPCLASS immediate encoding.
+    unsigned VFPClassImm = 0;
+    if (Check & fcQNan)
+      VFPClassImm |= X86::VFPClassQNaN;
+    if (Check & fcPosZero)
+      VFPClassImm |= X86::VFPClassPosZero;
+    if (Check & fcNegZero)
+      VFPClassImm |= X86::VFPClassNegZero;
+    if (Check & fcPosInf)
+      VFPClassImm |= X86::VFPClassPosInf;
+    if (Check & fcNegInf)
+      VFPClassImm |= X86::VFPClassNegInf;
+    if (Check & (fcPosSubnormal | fcNegSubnormal))
+      VFPClassImm |= X86::VFPClassDenormal;
+    if (Check & fcSNan)
+      VFPClassImm |= X86::VFPClassSNaN;
+    if ((Check & fcNegNormal) && (Check & fcNegSubnormal))
+      VFPClassImm |= X86::VFPClassNegFinite;
+
+    // Check if we can handle this test with VFPCLASS.
+    unsigned Handled = fcSNan | fcQNan | fcPosInf | fcNegInf | fcPosZero |
+                       fcNegZero | fcPosSubnormal | fcNegSubnormal;
+    if ((Check & fcNegSubnormal) && (Check & fcNegNormal))
+      Handled |= fcNegNormal;
+
+    // If there are flags we can't handle, fall back to expansion.
+    if (Check & ~Handled)
+      return SDValue();
+
+    // If no flags remain, return a constant.
+    if (VFPClassImm == 0)
+      return DAG.getConstant(Invert ? 1 : 0, DL, ResultVT);
+
+    // VFPCLASSS requires a vector input. Create minimal 128-bit vector.
+    unsigned SizeInBits = SrcVT.getSizeInBits();
+    MVT VecVT = MVT::getVectorVT(SrcVT, 128 / SizeInBits);
+    SDValue VecSrc = DAG.getNode(ISD::SCALAR_TO_VECTOR, DL, VecVT, Src);
+
+    SDValue Imm = DAG.getTargetConstant(VFPClassImm, DL, MVT::i32);
+    // VFPCLASSS returns v1i1 mask result.
+    SDValue V1Result =
+        DAG.getNode(X86ISD::VFPCLASSS, DL, MVT::v1i1, VecSrc, Imm);
+
+    // Convert v1i1 to i8: insert into v8i1, bitcast to i8.
+    SDValue Ins = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, MVT::v8i1,
+                              DAG.getConstant(0, DL, MVT::v8i1), V1Result,
+                              DAG.getVectorIdxConstant(0, DL));
+    SDValue Result = DAG.getBitcast(MVT::i8, Ins);
+
+    if (Invert)
+      Result = DAG.getNOT(DL, Result, MVT::i8);
+
+    // The result type may be i8 (promoted from i1).
+    if (ResultVT != MVT::i8)
+      Result = DAG.getNode(ISD::TRUNCATE, DL, ResultVT, Result);
+
+    return Result;
+  }
+
+  // Handle narrow vectors by widening.
+  // For f32/f64 without VLX, TableGen patterns handle widening to 512-bit.
+  // For f16/bf16 without VLX, we widen here in C++.
+  unsigned NumElts = SrcVT.getVectorNumElements();
+  MVT EltVT = SrcVT.getVectorElementType();
+  unsigned SrcSizeInBits = SrcVT.getSizeInBits();
+
+  // For f16/bf16 without VLX, widen to 512-bit. Otherwise widen to 128-bit.
+  bool NeedsWiden512 = !Subtarget.hasVLX() && SrcSizeInBits < 512 &&
+                       (EltVT == MVT::f16 || EltVT == MVT::bf16);
+  unsigned MinElts = NeedsWiden512 ? (512 / EltVT.getSizeInBits())
+                                   : (128 / EltVT.getSizeInBits());
+
+  if (NumElts < MinElts) {
+    MVT WideVT = MVT::getVectorVT(EltVT, MinElts);
+    MVT WideResultVT = MVT::getVectorVT(MVT::i1, MinElts);
+    SDValue Undef = DAG.getUNDEF(WideVT);
+    Src = DAG.getNode(ISD::INSERT_SUBVECTOR, DL, WideVT, Undef, Src,
+                      DAG.getVectorIdxConstant(0, DL));
+    SDValue WideOp =
+        DAG.getNode(ISD::IS_FPCLASS, DL, WideResultVT, Src, Op.getOperand(1));
+    return DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, ResultVT, WideOp,
+                       DAG.getVectorIdxConstant(0, DL));
+  }
+
+  // Check for fcFinite/fcNormal - can be handled by inverting.
+  // fcFinite = ~(nan | inf)
+  // fcNormal = ~(nan | inf | subnormal | zero)
+  bool Invert = false;
+  if (Check == fcFinite) {
+    Check = fcNan | fcInf;
+    Invert = true;
+  } else if (Check == fcNormal) {
+    Check = fcNan | fcInf | fcSubnormal | fcZero;
+    Invert = true;
+  }
+
+  // Convert LLVM FPClassTest flags to VFPCLASS immediate encoding.
+  unsigned VFPClassImm = 0;
+  if (Check & fcQNan)
+    VFPClassImm |= X86::VFPClassQNaN;
+  if (Check & fcPosZero)
+    VFPClassImm |= X86::VFPClassPosZero;
+  if (Check & fcNegZero)
+    VFPClassImm |= X86::VFPClassNegZero;
+  if (Check & fcPosInf)
+    VFPClassImm |= X86::VFPClassPosInf;
+  if (Check & fcNegInf)
+    VFPClassImm |= X86::VFPClassNegInf;
+  if (Check & (fcPosSubnormal | fcNegSubnormal))
+    VFPClassImm |= X86::VFPClassDenormal;
+  if (Check & fcSNan)
+    VFPClassImm |= X86::VFPClassSNaN;
+
+  // VFPCLASS's "Negative Finite" bit tests for negative finite values,
+  // which includes negative normal and negative subnormal.
+  // We only use it if both fcNegNormal and fcNegSubnormal are requested.
+  if ((Check & fcNegNormal) && (Check & fcNegSubnormal))
+    VFPClassImm |= X86::VFPClassNegFinite;
+
+  // Check if we can handle this test with VFPCLASS.
+  unsigned Handled = fcSNan | fcQNan | fcPosInf | fcNegInf | fcPosZero |
+                     fcNegZero | fcPosSubnormal | fcNegSubnormal;
+  // If fcNegNormal is set with fcNegSubnormal, we can handle it.
+  if ((Check & fcNegSubnormal) && (Check & fcNegNormal))
+    Handled |= fcNegNormal;
+
+  // If there are flags we can't handle, fall back to expansion.
+  if (Check & ~Handled)
+    return SDValue();
+
+  // If no flags remain, return a zero or all-ones mask.
+  if (VFPClassImm == 0)
+    return DAG.getConstant(Invert ? -1 : 0, DL, ResultVT);
+
+  SDValue Imm = DAG.getTargetConstant(VFPClassImm, DL, MVT::i32);
+  SDValue Result = DAG.getNode(X86ISD::VFPCLASS, DL, ResultVT, Src, Imm);
+
+  if (Invert)
+    Result = DAG.getNOT(DL, Result, ResultVT);
+
+  return Result;
+}
+
 /// ISD::FROUND is defined to round to nearest with ties rounding away from 0.
 /// This mode isn't supported in hardware on X86. But as long as we aren't
 /// compiling with trapping math, we can emulate this with
@@ -35152,6 +35350,7 @@ SDValue X86TargetLowering::LowerOperation(SDValue Op, SelectionDAG &DAG) const {
   case ISD::FADD:
   case ISD::FSUB:               return lowerFaddFsub(Op, DAG);
   case ISD::FROUND:             return LowerFROUND(Op, DAG);
+  case ISD::IS_FPCLASS:         return LowerIS_FPCLASS(Op, Subtarget, DAG);
   case ISD::FABS:
   case ISD::FNEG:               return LowerFABSorFNEG(Op, DAG);
   case ISD::FCOPYSIGN:          return LowerFCOPYSIGN(Op, DAG);
diff --git a/llvm/lib/Target/X86/X86InstrAVX512.td b/llvm/lib/Target/X86/X86InstrAVX512.td
index 52f34735ed..70104f6c28 100644
--- a/llvm/lib/Target/X86/X86InstrAVX512.td
+++ b/llvm/lib/Target/X86/X86InstrAVX512.td
@@ -2625,6 +2625,34 @@ multiclass avx512_fp_fpclass_all<string OpcodeStr, bits<8> opcVec,
 
 defm VFPCLASS : avx512_fp_fpclass_all<"vfpclass", 0x66, 0x67, SchedWriteFCmp>, EVEX;
 
+// VFPCLASS: Use 512bit version to implement 128/256 bit in case NoVLX.
+let Predicates = [HasDQI, NoVLX] in {
+  def : Pat<(v8i1 (X86Vfpclass (v8f32 VR256X:$src), (i32 timm:$imm))),
+            (COPY_TO_REGCLASS
+              (VFPCLASSPSZri
+                (INSERT_SUBREG (v16f32 (IMPLICIT_DEF)), VR256X:$src, sub_ymm),
+                timm:$imm),
+              VK8)>;
+  def : Pat<(v4i1 (X86Vfpclass (v4f64 VR256X:$src), (i32 timm:$imm))),
+            (COPY_TO_REGCLASS
+              (VFPCLASSPDZri
+                (INSERT_SUBREG (v8f64 (IMPLICIT_DEF)), VR256X:$src, sub_ymm),
+                timm:$imm),
+              VK4)>;
+  def : Pat<(v4i1 (X86Vfpclass (v4f32 VR128X:$src), (i32 timm:$imm))),
+            (COPY_TO_REGCLASS
+              (VFPCLASSPSZri
+                (INSERT_SUBREG (v16f32 (IMPLICIT_DEF)), VR128X:$src, sub_xmm),
+                timm:$imm),
+              VK4)>;
+  def : Pat<(v2i1 (X86Vfpclass (v2f64 VR128X:$src), (i32 timm:$imm))),
+            (COPY_TO_REGCLASS
+              (VFPCLASSPDZri
+                (INSERT_SUBREG (v8f64 (IMPLICIT_DEF)), VR128X:$src, sub_xmm),
+                timm:$imm),
+              VK2)>;
+}
+
