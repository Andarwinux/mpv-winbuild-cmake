   }
 
   if (ISD != ISD::DELETED_NODE) {
@@ -5329,6 +5346,11 @@ X86TTIImpl::getIntrinsicInstrCost(const IntrinsicCostAttributes &ICA,
         if (auto KindCost = Entry->Cost[CostKind])
           return adjustTableCost(Entry->ISD, *KindCost, LT, ICA.getFlags());
 
+    if (ST->hasDQI())
