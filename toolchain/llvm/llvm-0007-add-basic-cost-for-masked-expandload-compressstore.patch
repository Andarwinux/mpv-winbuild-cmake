From 9daf2150c35076428fb51fa351a453a8d430dc89 Mon Sep 17 00:00:00 2001
From: _ <>
Date: Fri, 11 Sep 2026 00:00:00 +0000
Subject: [PATCH] add basic cost for masked expandload/compressstore

---
 llvm/lib/Target/X86/X86TargetTransformInfo.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/llvm/lib/Target/X86/X86TargetTransformInfo.cpp b/llvm/lib/Target/X86/X86TargetTransformInfo.cpp
index c43341cbc3..db856afd15 100644
--- a/llvm/lib/Target/X86/X86TargetTransformInfo.cpp
+++ b/llvm/lib/Target/X86/X86TargetTransformInfo.cpp
@@ -6049,6 +6049,9 @@ X86TTIImpl::getMemIntrinsicInstrCost(const MemIntrinsicCostAttributes &MICA,
   case Intrinsic::masked_load:
   case Intrinsic::masked_store:
     return getMaskedMemoryOpCost(MICA, CostKind);
+  case Intrinsic::masked_expandload:
+  case Intrinsic::masked_compressstore:
+    return 2;
   }
 
   static const CostKindTblEntry AVX512VBMI2CostTable[] = {
